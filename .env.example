# Copy to .env. Everything is optional.

# Extra hostnames allowed in the Host header (comma-separated), besides localhost.
# Needed when serving via Tailscale or another hostname.
# DOCKET_HOSTS=

# The public address, used in `bun run sign-in-link` links and, when https, as the push contact.
# DOCKET_URL=https://docket.example.com

# Host port to expose. The container always listens on 7100 internally.
# PORT=7100

# Let webhooks reach private addresses (same host, LAN, tailnet) and plain http. Only if every admin may reach them.
# DOCKET_WEBHOOK_ALLOW_PRIVATE=true
