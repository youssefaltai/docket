# Copy to .env. Everything is optional; Docket works with none of this set.

# Shared access token, required outside a private network.
# Generate with: openssl rand -hex 32
# DOCKET_TOKEN=

# Extra hostnames allowed in the Host header (comma-separated), besides localhost.
# Needed when serving via Tailscale or another hostname.
# DOCKET_HOSTS=

# Host port to expose. The container always listens on 7100 internally.
# PORT=7100
