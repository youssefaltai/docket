# Copy to .env. Everything is optional.

# Extra hostnames allowed in the Host header (comma-separated), besides localhost.
# Needed when serving via Tailscale or another hostname.
# DOCKET_HOSTS=

# The public address, for links printed by `bun run sign-in-link`.
# DOCKET_URL=https://docket.example.com

# Host port to expose. The container always listens on 7100 internally.
# PORT=7100

# The assistant (docket-chat, next to Docket on the same host): its address on Docket's Docker network.
# CHAT_URL=http://docket-chat:7110

# Docker network name, shared with docket-chat. Change it only for a second Docket on the same host.
# DOCKET_NETWORK=docket
