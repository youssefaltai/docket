// Docket on Cloudflare Workers' free plan (src/worker/worker.ts), at docket.youssefaltai.com. Local: bunx wrangler dev.
// Secrets: DOCKET_SETUP_CODE (required for setup); BACKUP_TOKEN (scripts/backup.ts); ADMIN_TOKEN only while importing or
// recovering an account.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docket",
  "main": "src/worker/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "docket.youssefaltai.com", "custom_domain": true }],
  "vars": { "DOCKET_URL": "https://docket.youssefaltai.com", "DOCKET_HOSTS": "docket.youssefaltai.com" },
  "build": { "command": "bun scripts/build-worker.ts" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/ws", "/icons/*"]
  },
  "durable_objects": { "bindings": [{ "name": "DOCKET", "class_name": "Docket" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Docket"] }],
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "docket-attachments" }],
  "triggers": { "crons": ["0 * * * *"] }
}
